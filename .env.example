# Loaded by run_web.py; never commit the real .env file.
OPENAI_API_KEY=
PUBLIC_ORIGIN=https://santa.example.com
CF_ACCESS_TEAM_DOMAIN=https://your-team.cloudflareaccess.com
CF_ACCESS_AUD=
ADMIN_EMAILS=you@example.com
# Only requests arriving over loopback via cloudflared may supply CF-Connecting-IP.
TRUST_CLOUDFLARE_HEADERS=true
SANTA_DATA_DIR=./runtime
# Optional LAN owner access: configure-lan.py generates TLS files and prints these values.
SANTA_LAN_HOST=
SANTA_LAN_PORT=8443
SANTA_LAN_ORIGIN=
SANTA_LAN_CERT=
SANTA_LAN_KEY=
# Optional override; default is SANTA_DATA_DIR/owner-password.hash.
SANTA_OWNER_PASSWORD_FILE=
# SMS secrets stay here. Recipients and weekly Brisbane hours are configured in admin.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
