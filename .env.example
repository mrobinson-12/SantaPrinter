# Loaded by run_web.py; never commit the real .env file.
OPENAI_API_KEY=
PUBLIC_ORIGIN=https://santa.example.com
CF_ACCESS_TEAM_DOMAIN=https://your-team.cloudflareaccess.com
CF_ACCESS_AUD=
ADMIN_EMAILS=you@example.com
# Only requests arriving over loopback via cloudflared may supply CF-Connecting-IP.
TRUST_CLOUDFLARE_HEADERS=true
SANTA_DATA_DIR=./runtime

# Twilio API key credentials for paper-out SMS alerts (numbers/message live in admin).
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# Alternatively use Account SID + Auth Token, leaving both API key fields blank.
TWILIO_AUTH_TOKEN=
